# UAV Resolver — thin HTTP service that turns a JableTV/MissAV/SupJav/Hanime1
# video page URL into a playable m3u8/direct URL and forwards it to the
# remote download server. No ffmpeg, no GUI deps: it never touches video bytes.
#
# Multi-stage: pip/setuptools and build caches from the install step never
# reach the final image (they added ~15-20MB for no runtime benefit).
FROM python:3.12-slim AS builder

WORKDIR /app
COPY requirements-resolver.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements-resolver.txt

FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /install /usr/local
COPY src ./src

ENV PYTHONPATH=/app/src \
    PYTHONUNBUFFERED=1 \
    RESOLVER_DB_PATH=/data/resolver.db
# SQLite cache of titles / resolved URLs. Mount a volume here (-v uav-resolver-data:/data)
# so it survives container rebuilds.
RUN mkdir -p /data
VOLUME /data
# Set at `docker run` time (or in docker-compose):
#   RESOLVER_API_KEY   - shared secret the Android client must send as X-API-Key
#   REMOTE_DL_BASE_URL - e.g. http://your-server:38090
#   REMOTE_DL_USERNAME / REMOTE_DL_PASSWORD - remote download server login
# Optional — background detail prefetch for videos returned by list endpoints:
#   RESOLVER_PREFETCH=0                  - turn it off (default on)
#   RESOLVER_PREFETCH_DELAY_MIN / _MAX   - random gap between fetches, seconds (default 3 / 8)
#   RESOLVER_PREFETCH_QUEUE              - max pending URLs, oldest dropped first (default 300)
#   RESOLVER_CRAWL_LIMIT                 - videos given Recombee properties per POST
#                                          /api/crawl or /api/crawl/full (default 10000)
#   RESOLVER_BACKFILL_ATTEMPTS           - after a crawl, tries per page still without a
#                                          resolved_url (default 3)

EXPOSE 8060
CMD ["uvicorn", "uav_downloader.resolver.app:app", "--host", "0.0.0.0", "--port", "8060"]
